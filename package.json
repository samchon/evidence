{
  "name": "@evid/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone cross-language Evid Graph workspace.",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "start": "pnpm --filter @evid/test start",
    "build": "pnpm --filter=./packages/* -r run build",
    "test": "pnpm --filter @evid/test start",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "package:latest": "pnpm --filter=./packages/* -r publish --tag latest --access public",
    "package:next": "pnpm --filter=./packages/* -r publish --tag next --access public",
    "package:rc": "pnpm --filter=./packages/* -r publish --tag rc --access public",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "bumpp": "catalog:utils",
    "prettier": "catalog:typescript"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrtnlabs/evid.git"
  },
  "author": "Wrtn Technologies",
  "license": "MIT"
}
